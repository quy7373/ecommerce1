# Runtime
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public

# JWT (ES256 P-256 PEM keys; base64-encoded or literal with \n)
JWT_ISSUER=ecommerce-api
JWT_AUDIENCE=ecommerce-web
JWT_KEY_ID=key-2026-01
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=

# Application Envelope Encryption (AES-256-GCM; 32-byte hex or base64 master wrapping key)
ENCRYPTION_KEY_ID=local-kms-key-1
ENCRYPTION_MASTER_KEY=

# Google OAuth / OpenID Connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token

# Stripe (Test Mode Only — sk_test_... and whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_PREVIOUS=

# Product Image CDN Allowlist (comma-separated HTTPS origins, required in production)
APPROVED_IMAGE_CDN_ORIGINS=

# AI Support — Google Gemini (External AI stays OFF until owner approves provider/processing terms)
AI_SUPPORT_ENABLED=false
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_BUDGET_CENTS=0
AI_REQUEST_TIMEOUT_MS=10000

# Worker
WORKER_POLL_INTERVAL_MS=5000

# AUTH-002: Email/Password Authentication & Transactional Mail (dummy values only)
AUTH_EMAIL_HMAC_SECRET=replace-with-32-byte-random-secret
MAIL_ENCRYPTION_KEY_ID=local-mail-kms-key-1
MAIL_ENCRYPTION_MASTER_KEY=
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
PASSWORD_HASH_MAX_CONCURRENCY=4
MAIL_TRANSPORT=fake
MAIL_FROM=no-reply@example.test
SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT_MS=10000
MAIL_MAX_ATTEMPTS=5
