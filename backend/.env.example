# Runtime
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public

# Security Secrets (required in production; dev/test fallbacks auto-generated)
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
ENCRYPTION_MASTER_KEY=
MAIL_ENCRYPTION_MASTER_KEY=
AUTH_EMAIL_HMAC_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# Stripe (Test Mode Only — sk_test_... and whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI Support (Google Gemini)
AI_SUPPORT_ENABLED=false
GEMINI_API_KEY=

# Transactional Mail (MAIL_TRANSPORT: fake | smtp)
MAIL_TRANSPORT=fake
MAIL_FROM=no-reply@example.test
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
