# Frontend API base path (same-origin /api/v1 recommended for production)
VITE_API_BASE_URL=/api/v1

# Development proxy target used by Vite dev server for /api requests
VITE_DEV_API_PROXY=http://localhost:4000

# Optional comma-separated list of approved HTTPS image CDN hostnames (in addition to same-origin)
# Leave empty in local development to allow any valid HTTPS image URL without credentials
VITE_APPROVED_IMAGE_HOSTS=
